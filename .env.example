# Database Connection String (PostgreSQL Neon Cloud Database)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Flask Configuration
FLASK_SECRET_KEY=your_secure_flask_session_secret_key
FLASK_ENV=production

# Razorpay Payment Gateway Configuration
# Use Test Mode (rzp_test_...) during development and testing
# Switch to Live Mode (rzp_live_...) in production after KYC activation
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Delivery Timeline Window Configuration (Days)
DELIVERY_MIN_DAYS=7
DELIVERY_MAX_DAYS=15

# Optional Merchant UPI Fallback Configuration
MERCHANT_UPI_ID=9350439667@okbizaxis
MERCHANT_PAYEE_NAME=Tulsa Wears

# WhatsApp Cloud API (Optional)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Email Integration (Resend API or SMTP)
RESEND_API_KEY=re_your_api_key_here

